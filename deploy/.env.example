# Copy to deploy/.env. Run Compose from the repository root with --env-file.
# Token for a remotely managed Cloudflare Tunnel. Required for --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

SYNCTHING_GUI_PORT=8385
SYNCTHING_SYNC_PORT=22000
PKM_HTTP_PORT=3210

# Pin tags or digests here to control upgrades after the first deployment.
SYNCTHING_IMAGE=syncthing/syncthing:latest
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Optional MCP for a host-side OpenAI tunnel-client. Enable explicitly.
PKM_MCP_ENABLED=0
# set 1 when enabling write tools
PKM_MCP_WRITES=0
PKM_MCP_AUTH=token
PKM_MCP_HOST=0.0.0.0
PKM_MCP_HTTP_PORT=3211
# OAuth (Optional)
PKM_MCP_OAUTH_ISSUER=
PKM_MCP_OAUTH_JWKS_URL=
PKM_MCP_OAUTH_AUDIENCE=
PKM_MCP_RESOURCE_URL=
PKM_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# 許可する接続先 (Tunnel接続なら不要)
PKM_MCP_ALLOWED_ORIGINS=
PKM_MCP_PUBLIC_WEB_URL=
# At least 32 characters. Used by both PKM and start-openai-tunnel.sh.
# The existing MCP_BEARER_TOKEN name is also accepted when this is empty.
PKM_MCP_TOKEN=

# Credentials for the host-side OpenAI Secure MCP Tunnel (not sent to PKM).
CONTROL_PLANE_API_KEY=
OPENAI_TUNNEL_ID=
# Optional full executable path; otherwise PATH or ~/.local/bin is used.
TUNNEL_CLIENT_BIN=
OPENAI_TUNNEL_HEALTH_PORT=18080
